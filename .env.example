# Cadena de conexión a tu clúster de MongoDB Atlas
# Copia este archivo como ".env" y reemplaza el valor con tu URI real.
# Ejemplo de formato:
# MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

MONGODB_URI=
# Clave de la API de OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
